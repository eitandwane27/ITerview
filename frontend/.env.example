# Copy to .env and fill locally. VITE_* values are included in the browser build.
# Never put backend provider keys, database credentials, or private keys here.
VITE_BACKEND_URL=http://localhost:5000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional override; otherwise derived from VITE_BACKEND_URL.
# VITE_VOICE_AGENT_WS_URL=ws://localhost:5000/ws/voice-agent
