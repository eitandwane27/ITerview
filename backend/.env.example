# Copy to .env and fill locally. Never commit real credentials.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/iterview
# Must match VITE_FIREBASE_PROJECT_ID in the frontend configuration.
FIREBASE_PROJECT_ID=
# Server-only key with Member permissions, required to mint 30-second browser tokens.
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=

# Optional chatbot web search. Add a Tavily key to enable live searches.
# Keep this key on the backend; never use a VITE_ variable for it.
TAVILY_API_KEY=
# Set false to disable search even when a key is present.
CHATBOT_WEB_SEARCH_ENABLED=true

# Optional model overrides; omit to use the application's defaults.
# DEEPSEEK_MODEL=
# DEEPSEEK_CHATBOT_MODEL=
# VOICE_AGENT_DEEPSEEK_MODEL=

# Optional protected voice-agent LLM proxy.
# VOICE_AGENT_LLM_ENDPOINT_URL=
# VOICE_AGENT_LLM_PROXY_TOKEN=

# Optional local STT diagnostics.
# STT_DEBUG=false
