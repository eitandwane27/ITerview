# Copy to .env and fill locally. Never commit real credentials.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/iterview
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=

# Optional model overrides; omit to use the application's defaults.
# DEEPSEEK_MODEL=
# DEEPSEEK_CHATBOT_MODEL=
# VOICE_AGENT_DEEPSEEK_MODEL=

# Optional protected voice-agent LLM proxy.
# VOICE_AGENT_LLM_ENDPOINT_URL=
# VOICE_AGENT_LLM_PROXY_TOKEN=

# Optional local STT diagnostics.
# STT_DEBUG=false
